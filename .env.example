DJANGO_SECRET_KEY=django-insecure-medical-ai-assistant-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=medical_documents
QDRANT_LOCAL_PATH=./qdrant_storage
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
DENSE_TOP_K=20
SPARSE_TOP_K=20
RERANK_TOP_K=8
MAX_UPLOAD_SIZE_MB=20
RERANK_SCORE_THRESHOLD=-8.5
GEMINI_TIMEOUT=120.0
GEMINI_THINKING_LEVEL=medium
